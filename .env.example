# Optional API/WebSocket token. Leave empty for local development only.
MC_API_KEY=

# Comma-separated origins allowed to call the dashboard API.
# Production example: https://panel.example.com
MC_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agent connections that miss this many seconds of heartbeats become offline.
MC_HEARTBEAT_TIMEOUT_SECONDS=45

# Remote Ollama OpenAI-compatible endpoint. Leave blank to disable AI calls.
# Either http://ollama-host:11434 or http://ollama-host:11434/v1 is accepted.
MC_OLLAMA_BASE_URL=
MC_OLLAMA_MODEL=qwen3:8b

# Optional bearer token required by a proxy in front of Ollama. Do not expose it
# to the frontend or commit it to source control.
MC_OLLAMA_API_KEY=
MC_OLLAMA_TIMEOUT_SECONDS=90
MC_AI_DECISION_HISTORY_SIZE=300
MC_AI_MAX_TOOL_ROUNDS=4
